# ═══════════════════════════════════════════════════════════════════════════
#  NOIRÉ — Environment
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET= # generate with: openssl rand -base64 32

# ── Database (Prisma / PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/noire

# ── Email (Resend) — optional; left empty the service is safely disabled ──
RESEND_API_KEY=
EMAIL_FROM=NOIRÉ <reservations@yourdomain.com>

# ── Media (Cloudinary) — optional; empty disables cloud upload ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (Stripe) — optional; empty disables checkout ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Rate limiting (Upstash Redis) — optional; empty falls back to in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Seed credentials — only read by prisma/seed.ts, never leaked ──────────
SEED_ADMIN_EMAIL=admin@noire.test
SEED_ADMIN_PASSWORD= # provide at seed time; do not commit a real password